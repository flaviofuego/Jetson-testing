# x86 GPU (Linux, CUDA 11.8+)
# devel image includes nvcc + CUDA headers needed to compile C++/CUDA extensions
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel

WORKDIR /app

RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    cmake git g++ ninja-build libgl1 libglib2.0-0 libgomp1 tzdata libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip only — do NOT upgrade setuptools, torch 2.1 needs the conda
# setuptools that bundles pkg_resources (newer setuptools breaks cpp_extension).
RUN pip install --no-cache-dir --upgrade pip

# ── 1. Clone P2C ──────────────────────────────────────────────────────────────
RUN git clone https://github.com/CuiRuikai/Partial2Complete.git /opt/p2c

# ── 2. Build P2C CUDA extensions via setup.py ────────────────────────────────
# TORCH_CUDA_ARCH_LIST must be set — torch 2.1 _get_cuda_arch_flags crashes
# with IndexError if the list is empty (no GPU detected at build time).
# 7.5=Turing, 8.0/8.6=Ampere, 8.9=Ada Lovelace (RTX 4000 Ada)
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9"
RUN cd /opt/p2c/extensions/chamfer_dist && python setup.py install
RUN cd /opt/p2c/extensions/pointops    && python setup.py install

# ── 3. Clone NU-MCC ───────────────────────────────────────────────────────────
RUN git clone https://github.com/sail-sg/numcc.git /opt/numcc

# ── 4. Python deps ────────────────────────────────────────────────────────────
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# ── 5. pytorch3d — pre-built wheel available for x86 + CUDA 11.8 ─────────────
RUN pip install --no-cache-dir \
    'pytorch3d @ https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu118_pyt210/pytorch3d-0.7.5-cp310-cp310-linux_x86_64.whl' || \
    pip install --no-cache-dir \
    'pytorch3d @ git+https://github.com/facebookresearch/pytorch3d.git' || \
    echo "WARNING: pytorch3d build failed — ManifoldnessConstraint will not work"

# ── 6. nksr — Neural Kernel Surface Reconstruction (build from source) ───────
# nksr wheel server (nksr.huangjh.tech) was discontinued; build from the repo.
# setup.py downloads OpenVDB + Eigen at build time and compiles CUDA extensions.
# --no-build-isolation: uses the installed torch (2.1.0) instead of re-downloading.
# torch-scatter required by nksr Python code; wheel keyed to torch+cu version.
RUN pip install --no-cache-dir \
    torch-scatter -f https://data.pyg.org/whl/torch-2.1.0+cu118.html
# gitpython needed by nksr setup.py to download OpenVDB + Eigen at build time
RUN pip install --no-cache-dir gitpython
COPY nksr/package/ /opt/nksr/
RUN pip install --no-cache-dir --no-build-isolation /opt/nksr/ || \
    echo "WARNING: nksr build failed — noksr method will use BPA fallback"

# ── 6b. SAP/DPSR meshing dep — marching cubes ────────────────────────────────
RUN pip install --no-cache-dir PyMCubes

# ── 6c. LightweightMR (CVPR 2025) — curvature-adaptive low-poly meshing ──────
# Per-object optimization mesher (--mesh-method lwmr). Needs:
#   - CGAL + boost + gmp/mpfr + Eigen for the Delaunay binaries
#   - spconv/torch_scatter/flash-less PointTransformerV3 for the VG network
# The Delaunay tools are built from PATCHED sources (lwmr_patches/): upstream
# links the Open3D C++ SDK, whose prebuilt binaries are clang/libc++-only and
# cannot be linked from this gcc/libstdc++ toolchain — the patch swaps Open3D
# for a ~150-line PLY reader/writer (miniply.h). Build steps are best-effort
# (|| echo): if any piece fails, pipeline.py falls back to poisson at runtime.
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libcgal-dev libboost-dev libboost-thread-dev libgmp-dev libmpfr-dev libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/CharizardChenZhang/LightweightMR.git /opt/lwmr
RUN pip install --no-cache-dir pyhocon fpsample addict cython cachetools spconv-cu118
# kdtree Cython/C++ extension used for fast SDF queries.
# The bundled kdtree.c was generated by an old Cython and uses ++Py_REFCNT(o),
# which is not an lvalue on Python >= 3.10 — regenerate from the .pyx first.
RUN cd /opt/lwmr/models/cpplib && \
    cython libkdtree/pykdtree/kdtree.pyx && \
    CC=gcc CXX=g++ python setup.py build_ext --inplace || \
    echo "WARNING: lwmr cpplib build failed — lwmr method unavailable"
COPY lwmr_patches/miniply.h lwmr_patches/create_delaunay.cc /opt/lwmr/models/delaunay_meshing/create_delaunay/
COPY lwmr_patches/CMakeLists_delaunay.txt /opt/lwmr/models/delaunay_meshing/create_delaunay/CMakeLists.txt
COPY lwmr_patches/miniply.h lwmr_patches/create_mesh.cc /opt/lwmr/models/delaunay_meshing/create_mesh/
COPY lwmr_patches/CMakeLists_mesh.txt /opt/lwmr/models/delaunay_meshing/create_mesh/CMakeLists.txt
RUN cd /opt/lwmr/models/delaunay_meshing/create_delaunay && \
    cmake -DCMAKE_BUILD_TYPE=Release . && make && \
    cd ../create_mesh && \
    cmake -DCMAKE_BUILD_TYPE=Release . && make || \
    echo "WARNING: lwmr Delaunay binaries build failed — lwmr method unavailable"
# Pre-compile the hashencoder JIT CUDA extension (torch cpp_extension.load into
# ./tmp_build) so the first lwmr run doesn't pay ~2 min of nvcc. PYTHONPATH
# cleared: /opt/p2c's regular `models` package shadows lwmr's namespace package.
# backend.py hardcodes -std=c++14; torch 2.1 headers require C++17.
RUN sed -i 's/c++14/c++17/g' /opt/lwmr/models/hashencoder/backend.py
RUN cd /opt/lwmr && PYTHONPATH= python -c \
    "from models.hashencoder.backend import _backend; print('hashencoder JIT OK')" || \
    echo "WARNING: hashencoder JIT pre-build failed — will compile at first lwmr run"

# ── 7. Pipeline modules ───────────────────────────────────────────────────────
COPY pointcloud_utils.py mesh_utils.py sdf_generator.py pipeline.py remesh.py /app/

# ── 7. Runtime environment ────────────────────────────────────────────────────
# Weights downloaded once on host: python tools/download_models_numcc.py
# Mount at runtime: -v ~/models/numcc:/opt/models:ro
ENV PYTHONPATH=/opt/p2c:/opt/numcc:/app
ENV PYTHONWARNINGS=ignore::FutureWarning,ignore::UserWarning

ENTRYPOINT ["python3", "/app/pipeline.py"]
